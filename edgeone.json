{
  "$schema": "https://edgeone.ai/schemas/pages.json",
  "name": "liukanshan-recommend",
  "build": {
    "output": "frontend"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://your-backend-server.com/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}